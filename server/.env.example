# Copy to .env. These defaults match the PostgreSQL that `npm run setup`
# starts for you — the embedded one from node_modules, on port 5433 with a
# `postgres` superuser. Nothing has to be installed for them to work.
#
# Port 5433 rather than the usual 5432 deliberately: it leaves a system or
# Docker PostgreSQL on the default port untouched, so `npm run db:seed` cannot
# reach past this project into a database that belongs to something else.
DATABASE_URL=postgresql://postgres@localhost:5433/pawsome
PORT=4000

# Origin allowed to call the API. The Vite dev server, and the preview server
# the production build and the Playwright suite are served from.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Resend API key. Booking and contact submissions send a confirmation to the
# submitter and a notification to OWNER_EMAIL. If unset, the DB write still
# succeeds and the send is skipped with a warning — mail failures never fail
# a submission.
RESEND_API_KEY=
MAIL_FROM=Pawsome Pet Services <onboarding@resend.dev>
OWNER_EMAIL=
